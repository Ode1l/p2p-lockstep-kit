{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": "../..",
    "paths": {
      "p2p-lockstep-kit-network": ["./src/network/index.ts"],
      "p2p-lockstep-kit-session": ["./src/session/index.ts"],
      "p2p-lockstep-kit-ui": ["./src/ui/index.ts"]
    }
  },
  "include": ["src/**/*.ts",
    "vite.config.ts"
  ]
}
